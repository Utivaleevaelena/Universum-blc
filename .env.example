# Block 07 enquiry delivery. Server-only. Set real values in Vercel (Project → Settings →
# Environment Variables) or a local untracked .env — never commit values.
RESEND_API_KEY=
# One or more recipients, comma-separated
ENQUIRY_TO=
# Sender on a domain verified in Resend, e.g. "Universum website <forms@your-verified-domain>"
ENQUIRY_FROM=
# Development only (ignored in production builds): mock = stub success, fail = stub error
ENQUIRY_MOCK=
