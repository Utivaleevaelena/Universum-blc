---
import { Picture } from 'astro:assets';
import { routeMechanismContent } from '../../i18n/content';
import type { Locale } from '../../i18n/routes';
import '../../styles/route-mechanism.css';

import environment from '../../assets/route-mechanism/route-assembly-environment-background-v01.png';
import layersRaw from '../../assets/route-mechanism/route-assembly-layer-symbols-v01.svg?raw';
import RouteAssembly from './RouteAssembly.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = routeMechanismContent[locale];

// ───────── Layer symbols (approved layered SVG, inlined) ─────────
// Each approved group is cut out of the source and placed in its own panel so the
// same markup works as a desktop plane layer and as a mobile panel. The group ids
// and nested groups are preserved. Changes: the group's source translate is
// dropped (placement is done by the panel), the source CSS classes get an `rm-`
// prefix (so nothing collides with page CSS), the blur filter and baked node /
// glow dots are removed (the route nodes are code-native), and the film gets a
// per-panel gradient id.
const layerIds = [
  'layer-task-context',
  'layer-constraints-timing',
  'layer-route-logic',
  'layer-modes-formalities',
  'layer-agreed-next-step',
] as const;

const cut = (id: string, k: number) => {
  const m = layersRaw.match(new RegExp(`<g id="${id}"[^>]*>[\\s\\S]*?\\n {2}</g>`));
  if (!m) throw new Error(`Route Mechanism: group ${id} not found in the layer SVG`);
  return m[0]
    .replace(/^(<g id="[^"]+")([^>]*?) transform="[^"]*"/, '$1$2')
    .replace(/<circle fill="#F5D343"[^>]*filter="url\(#node-glow\)"[^>]*\/>\s*/g, '')
    .replace(/<circle class="node"[^>]*\/>\s*/g, '')
    .replace(
      /<path class="film"/g,
      `<path class="rm-film" fill="url(#rm-film-${k})"`,
    )
    .replace(/<path class="cyan" d="M25 194/, '<path class="rm-rail" d="M25 194')
    .replace(/class="([^"]+)"/g, (full, cls: string) =>
      cls.startsWith('rm-') ? full : `class="${cls.split(/\s+/).map((c) => `rm-${c}`).join(' ')}"`,
    );
};
const layers = layerIds.map((id, i) => cut(id, i + 1));

// ───────── Desktop geometry: the approved reference grid, 1672 × 941 ─────────
const W = 1672;
const H = 941;
const S = 0.86; // scale of one layer panel in reference units
const VB = { x: 0, y: 70, w: 960, h: 215 }; // shared local frame of every layer group
const filmTop = [95, 240, 385, 530, 675]; // where each film's top edge lands
const left = [640, 590, 545, 490, 435]; // staircase to the left, as in the reference
const top = filmTop.map((f) => f - (88 - VB.y) * S);
const panelW = VB.w * S;
const labelAt = left.map((l, i) => ({
  // right of the film, vertically centred on it
  x: l + (i === 4 ? 745 : 945) * S + 22,
  y: top[i] + (177 - VB.y) * S,
}));
const labelWidth = [185, 235, 285, 330, 310];
const localNode = [
  [378, 130],
  [410, 130],
  [410, 130],
  [410, 130],
  [694, 172],
];
const nodes = localNode.map(([nx, ny], i) => ({
  x: Math.round(left[i] + (nx - VB.x) * S),
  y: Math.round(top[i] + (ny - VB.y) * S),
}));

const pct = (n: number, of: number) => `${((n / of) * 100).toFixed(3)}%`;
const itemStyle = (i: number) =>
  `--k:${i + 1};--lx:${pct(labelAt[i].x, W)};--ly:${pct(labelAt[i].y, H)};--lw:${pct(labelWidth[i], W)}`;
const panelStyle = (i: number) =>
  `--px:${pct(left[i], W)};--py:${pct(top[i], H)};--pw:${pct(panelW, W)}`;

// Route: entry → node 1 → … → node 5 → exit. Control points make a gentle S.
const f = (n: number) => Math.round(n);
const link = (a: { x: number; y: number }, b: { x: number; y: number }, bend: number) => {
  const dy = b.y - a.y;
  return `M${a.x} ${a.y} C${f(a.x + bend)} ${f(a.y + dy * 0.55)} ${f(b.x - bend)} ${f(b.y - dy * 0.55)} ${b.x} ${b.y}`;
};
const n = nodes;
const exit = { x: 1336, y: 941 };
const segmentPaths = [
  `M690 0 C690 80 ${f(n[0].x - 170)} ${n[0].y} ${n[0].x} ${n[0].y}`,
  link(n[0], n[1], 44),
  link(n[1], n[2], -44),
  link(n[2], n[3], 44),
  link(n[3], n[4], -64),
  `M${n[4].x} ${n[4].y} C${n[4].x + 100} ${n[4].y + 55} ${f(exit.x - 120)} ${exit.y - 70} ${exit.x} ${exit.y}`,
];
const thresholds = [0.1, 0.26, 0.42, 0.58, 0.76, 0.92];
const segments = segmentPaths.map((d, i) => {
  const a = i === 0 ? 0 : thresholds[i - 1];
  return { d, a, w: Math.round((thresholds[i] - a) * 1000) / 1000 };
});
const arrow = { x: exit.x - 3, y: exit.y - 10, rot: 62 };
---

<section
  class="route-mechanism"
  id="route-mechanism"
  aria-labelledby="route-mechanism-title"
  data-content-status={t.status}
>
  <div class="route-mechanism__stage">
    <header class="route-mechanism__copy">
      <h2 class="route-mechanism__title" id="route-mechanism-title">{t.title}</h2>
      <p class="route-mechanism__body">{t.body}</p>
    </header>

    <ol class="route-mechanism__stages" role="list">
      {
        t.stages.map((s, i) => (
          <li class="rm-item rk" style={itemStyle(i)} data-stage={s.id}>
            <span class="rm-label">{s.label}</span>
            <div class="rm-panel" style={panelStyle(i)} aria-hidden="true">
              <svg
                class="rm-layer"
                viewBox={`${VB.x} ${VB.y} ${VB.w} ${VB.h}`}
                focusable="false"
              >
                <defs>
                  <linearGradient id={`rm-film-${i + 1}`} x1="0" y1="0" x2="1" y2="1">
                    <stop stop-color="#0E7080" stop-opacity=".26"></stop>
                    <stop offset="1" stop-color="#062C3B" stop-opacity=".1"></stop>
                  </linearGradient>
                </defs>
                <Fragment set:html={layers[i]} />
              </svg>
            </div>
          </li>
        ))
      }
    </ol>

    <!-- Decorative scene: environment, grid, map dots and the continuous desktop route. -->
    <div class="route-mechanism__scene" aria-hidden="true">
      <Picture
        class="rm-bg"
        src={environment}
        alt=""
        widths={[768, 1280, 1672]}
        sizes="(min-width: 1200px) 100vw, 1100px"
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        quality={50}
        loading="lazy"
        decoding="async"
      />
      <div class="rm-veil"></div>
      <div class="rm-grid"></div>
      <svg class="rm-map" viewBox="0 0 1672 941" focusable="false">
        <defs>
          <pattern id="rm-dots" width="9" height="9" patternUnits="userSpaceOnUse">
            <circle cx="2" cy="2" r="1.7" fill="#7fd9e6"></circle>
          </pattern>
          <clipPath id="rm-land">
            <path
              d="M30 520 L92 500 L150 512 L196 538 L184 572 L150 590 L158 628 L124 648 L96 626 L82 584 L42 566 Z"
            ></path>
            <path
              d="M236 500 L300 482 L372 490 L430 516 L486 508 L520 540 L486 566 L430 560 L402 600 L350 626 L318 604 L302 566 L260 548 Z"
            ></path>
          </clipPath>
        </defs>
        <rect x="0" y="470" width="560" height="200" fill="url(#rm-dots)" clip-path="url(#rm-land)"
        ></rect>
      </svg>
      <RouteAssembly segments={segments} nodes={nodes} arrow={arrow} />
    </div>
  </div>
</section>

<script>
  // Scroll-linked route assembly. Native scroll only: no pinning, no timers, no
  // continuous loop. One passive scroll + resize listener, at most one DOM write
  // pass per animation frame, state derived from the actual scroll position.
  const section = document.querySelector<HTMLElement>('#route-mechanism');
  const stage = section?.querySelector<HTMLElement>('.route-mechanism__stage') ?? null;
  const list = section?.querySelector<HTMLElement>('.route-mechanism__stages') ?? null;

  if (section && stage && list && list.children.length === 5) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const wide = window.matchMedia('(min-width: 1200px)');
    const items = Array.from(list.children) as HTMLElement[];
    // Approved thresholds: stage 1…5 start, exit.
    const T = [0.1, 0.26, 0.42, 0.58, 0.76, 0.92];
    const clamp01 = (n: number) => Math.min(1, Math.max(0, n));

    let frame = 0;
    let running = false;
    let last = { step: -1, p: -1, fill: -1 };

    // Map the scroll position onto 0…1 between two document offsets. The end is
    // capped at the last reachable scroll position, so the route can still finish
    // while this is the last block on the page.
    const range = (y: number, start: number, end: number) =>
      end > start ? clamp01((y - start) / (end - start)) : y >= start ? 1 : 0;

    const compute = () => {
      frame = 0;
      const vh = window.innerHeight;
      const y = window.scrollY;
      const maxY = Math.max(0, document.documentElement.scrollHeight - vh);
      let step = 0;
      let p = 1;
      let fill = 1;

      if (wide.matches) {
        // Desktop: block progress. Starts when the stage top reaches 80% of the
        // viewport, ends when its bottom reaches 60%.
        const r = stage.getBoundingClientRect();
        p = range(y, y + r.top - 0.8 * vh, Math.min(y + r.bottom - 0.6 * vh, maxY));
        step = p >= T[5] ? 6 : T.slice(0, 5).filter((t) => p >= t).length;
        fill = p;
      } else {
        // Tablet / mobile: vertical axis. The line fills down while a reference
        // line at 60% of the viewport moves through the list; a node lights as
        // the line reaches it.
        const nodeY = parseFloat(getComputedStyle(list).getPropertyValue('--rm-node-y')) || 11;
        const ref = vh * 0.6;
        const lr = list.getBoundingClientRect();
        fill = range(y, y + lr.top - ref, Math.min(y + lr.top + lr.height - ref, maxY));
        let reached = 0;
        for (const li of items) {
          const frac = (li.getBoundingClientRect().top - lr.top + nodeY) / (lr.height || 1);
          if (frac <= fill) reached += 1;
        }
        step = fill >= 1 ? 6 : Math.min(5, reached);
        p = fill;
      }

      const pr = Math.round(p * 1000) / 1000;
      const fr = Math.round(fill * 1000) / 1000;
      if (step !== last.step) {
        section.style.setProperty('--rs', String(step));
        section.dataset.step = String(step);
      }
      if (pr !== last.p) section.style.setProperty('--rp', String(pr));
      if (fr !== last.fill) section.style.setProperty('--rfill', String(fr));
      last = { step, p: pr, fill: fr };
    };

    const schedule = () => {
      if (!frame) frame = window.requestAnimationFrame(compute);
    };

    const start = () => {
      if (running) return;
      running = true;
      window.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('resize', schedule, { passive: true });
      compute();
      // Enable transitions only after the first state is in place.
      window.requestAnimationFrame(() => {
        if (running) section.dataset.enhanced = 'true';
      });
    };

    const stop = () => {
      if (!running) return;
      running = false;
      window.removeEventListener('scroll', schedule);
      window.removeEventListener('resize', schedule);
      if (frame) window.cancelAnimationFrame(frame);
      frame = 0;
      last = { step: -1, p: -1, fill: -1 };
      delete section.dataset.enhanced;
      delete section.dataset.step;
      section.style.removeProperty('--rs');
      section.style.removeProperty('--rp');
      section.style.removeProperty('--rfill');
    };

    const sync = () => (reduce.matches ? stop() : start());
    reduce.addEventListener('change', sync);
    sync();
  }
</script>
